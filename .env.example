# Salin file ini menjadi .env lalu isi. JANGAN commit .env
GEMINI_API_KEY=isi_api_key_gemini_anda
# Samakan dengan model yang Anda pakai di agent.py AMARA
GEMINI_MODEL=gemini-2.5-flash
# String acak panjang; dipakai sebagai kata sandi API (header X-Token)
KUCING_TOKEN=ganti_dengan_string_acak_panjang
# Pisahkan dengan koma bila ingin membatasi asal; * = semua (token tetap wajib)
ALLOWED_ORIGINS=*
# Opsional
# KUCING_WORKSPACE=workspaces
# KUCING_MAX_TOKENS=16384
